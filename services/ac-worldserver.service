[Unit]
Description=AzerothCore Worldserver
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=AzerothCore
WorkingDirectory=/opt/AzerothCore
ExecStart=/usr/bin/screen -S worldserver -D -m /opt/AzerothCore/acore.sh run-worldserver

[Install]
WantedBy=multi-user.target
